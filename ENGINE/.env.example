# Æthel Engine — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.

# ── ARC Testnet RPC ──────────────────────────────────────────────────────────
RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002

# ── Contract Addresses ────────────────────────────────────────────────────────
MARKETPLACE_ADDRESS=0xD3362dB9Afa0D9e0FA6Eb9909527BFb6693AAe53
MARKETPLACE_DEPLOY_BLOCK=53327024
USDC_ADDRESS=0x3600000000000000000000000000000000000000
GATEWAY_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9

# ── Dispatcher Server ─────────────────────────────────────────────────────────
PORT=4000
ALLOW_MOCK_AUTH=false

# ── Circle Developer-Controlled Wallets & App Kit ─────────────────────────────
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET=your_circle_32_byte_entity_secret_hex_here
KIT_KEY=your_circle_kit_key_here
NEXT_PUBLIC_ARC_CHAIN=Arc_Testnet
APP_FEE_BPS=25
APP_FEE_RECIPIENT=0x2793309a81D4111b8a5FEDb9A16a1DdE49D3bfeA

# ── Private Key & LLM Keys ───────────────────────────────────────────────────
PRIVATE_KEY=your_engine_evm_private_key_hex_here
GEMINI_API_KEY=your_google_gemini_api_key_here
# GEMINI_API_KEY2=optional_key_rotation_2
# GEMINI_API_KEY3=optional_key_rotation_3
