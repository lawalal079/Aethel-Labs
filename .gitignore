# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js Build Artifacts
/.next/
/out/
/build

# Environment & Secret Files (STRICTLY IGNORED)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
ENGINE/.env
!.env.example
!ENGINE/.env.example

# Engine Runtime Data & Sessions
ENGINE/data/sessions/
ENGINE/data/*.json
!ENGINE/data/.gitkeep
ENGINE/dist/
ENGINE/node_modules/

# Administrative & Internal Test Scripts (Do Not Touch Production)
ENGINE/scripts/

# Internal Documentation & Agent Artifacts (Do Not Push to Git)
ux.md
AETHEL_LABS_ROADMAP.md
AETHEL_LABS_SYSTEM_DESIGN.md
CIRCLE_AGENT_WALLETS_REFERENCE.md
ENGINE_EXECUTION_PATTERNS.md
.antigravity-storage/
.gemini/
scratch/
.md
*:Zone.Identifier

# OS & Misc
.DS_Store
Thumbs.db
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & TypeScript
.vercel
*.tsbuildinfo
next-env.d.ts
